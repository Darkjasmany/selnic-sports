generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH & USERS
// ==========================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ORGANIZER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  ORGANIZER
}

// ==========================================
// DISCIPLINES
// ==========================================

model Discipline {
  id              String     @id @default(cuid())
  name            String     @unique
  playersPerField Int
  maxSubstitutions Int?
  allowsDraw      Boolean    @default(true)
  categories      Category[]
  teams           Team[]
  players         Player[]
  tournaments     Tournament[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ==========================================
// CATEGORIES
// ==========================================

model Category {
  id           String       @id @default(cuid())
  disciplineId String
  name         String
  discipline   Discipline   @relation(fields: [disciplineId], references: [id])
  teams        Team[]
  matches      Match[]
  tournaments  Tournament[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([disciplineId, name])
}

// ==========================================
// TEAMS
// ==========================================

model Team {
  id           String       @id @default(cuid())
  name         String
  disciplineId String
  categoryId   String
  location     String?
  managerPhone String?
  coachName    String?
  discipline   Discipline   @relation(fields: [disciplineId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  players      TeamPlayer[]
  homeMatches  Match[]      @relation("HomeTeam")
  awayMatches  Match[]      @relation("AwayTeam")
  teamGroups   TeamGroup[]
  incidentTeams MatchIncident[] @relation("IncidentTeam")
  createdAt    DateTime     @default(now())

  @@unique([disciplineId, categoryId, name])
}

// ==========================================
// PLAYERS
// ==========================================

model Player {
  id               String        @id @default(cuid())
  firstName        String
  lastName         String
  birthDate        DateTime
  documentId       String        @unique
  phone            String?
  address          String?
  bloodType        String?
  nationality      String        @default("Ecuatoriana")
  photoUrl         String?
  biometricData    Json?
  biometricType    BiometricType @default(FACIAL)
  isActive         Boolean       @default(true)
  disciplineId     String?
  discipline       Discipline?   @relation(fields: [disciplineId], references: [id])
  guardianName     String?
  guardianPhone    String?
  guardianEmail    String?
  guardianRelation String?

  // Información académica (opcional)
  educationalUnit    String?
  educationalLevel   String?
  educationalAddress String?

  teams            TeamPlayer[]
  matchValidations MatchValidation[]
  incidents        MatchIncident[]
  assistedIncidents MatchIncident[] @relation("AssistPlayer")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum BiometricType {
  FACIAL
  FINGERPRINT
}

model TeamPlayer {
  id       String   @id @default(cuid())
  teamId   String
  playerId String
  team     Team     @relation(fields: [teamId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id])
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  @@unique([teamId, playerId])
}

// ==========================================
// MATCHES
// ==========================================

model Match {
  id                String            @id @default(cuid())
  homeTeamId        String
  awayTeamId        String
  categoryId        String
  tournamentId      String?
  groupId           String?
  phase             MatchPhase?
  matchDay          Int?
  scheduledTime     DateTime?
  scheduledAt       DateTime
  status            MatchStatus       @default(PENDING)
  homeScore         Int?
  awayScore         Int?
  notes             String?
  homeTeam          Team              @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam          Team              @relation("AwayTeam", fields: [awayTeamId], references: [id])
  category          Category          @relation(fields: [categoryId], references: [id])
  tournament        Tournament?       @relation(fields: [tournamentId], references: [id])
  group             Group?            @relation(fields: [groupId], references: [id])
  validations       MatchValidation[]
  incidents         MatchIncident[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([homeTeamId, awayTeamId, tournamentId])
}

enum MatchStatus {
  PENDING
  VALIDATING_PLAYERS
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchPhase {
  GROUPS
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

model MatchValidation {
  id          String   @id @default(cuid())
  matchId     String
  playerId    String
  teamSide    TeamSide
  validatedAt DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id])
  player      Player   @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

enum TeamSide {
  HOME
  AWAY
}

model MatchIncident {
  id             String       @id @default(cuid())
  matchId        String
  playerId       String?
  teamId         String?
  assistPlayerId String?
  type           IncidentType
  minute         Int?
  period         Int?
  quantity       Int?
  points         Int?
  notes          String?
  match          Match        @relation(fields: [matchId], references: [id])
  player         Player?      @relation(fields: [playerId], references: [id])
  team           Team?        @relation("IncidentTeam", fields: [teamId], references: [id])
  assistPlayer   Player?      @relation("AssistPlayer", fields: [assistPlayerId], references: [id])
}

enum IncidentType {
  GOAL
  YELLOW_CARD
  RED_CARD
  CORNER
  FOUL
  SUBSTITUTION
  BASKET_2
  BASKET_3
  FREE_THROW
  FOUL_BASKET
  BLOCK
  TURNOVER
  TIMEOUT
  REBOUND
  ASSIST
  STEAL
  CHECK
  CHECKMATE
  RESIGNATION
  DRAW_CHESS
  CAPTURED_PIECE
  NOTE
}

// ==========================================
// TOURNAMENTS
// ==========================================

model Tournament {
  id                String          @id @default(cuid())
  name              String
  disciplineId      String
  categoryId        String
  formatType        FormatType
  generationMode    GenerationMode
  qualifiedPerGroup Int             @default(2)
  maxGroups         Int?
  discipline        Discipline      @relation(fields: [disciplineId], references: [id])
  category          Category        @relation(fields: [categoryId], references: [id])
  groups            Group[]
  matches           Match[]
  startDate         DateTime?
  endDate           DateTime?
  status            TournamentStatus @default(CREATED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum FormatType {
  GROUPS_AND_KNOCKOUT
  KNOCKOUT_ONLY
  ROUND_ROBIN
}

enum GenerationMode {
  AUTOMATIC
  SEMI_AUTOMATIC
  MANUAL
}

enum TournamentStatus {
  CREATED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Group {
  id           String      @id @default(cuid())
  tournamentId String
  name         String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])
  matches      Match[]
  teamGroups   TeamGroup[]
  createdAt    DateTime    @default(now())

  @@unique([tournamentId, name])
}

model TeamGroup {
  id         String   @id @default(cuid())
  teamId     String
  groupId    String
  team       Team     @relation(fields: [teamId], references: [id])
  group      Group    @relation(fields: [groupId], references: [id])
  position   Int?
  points     Int      @default(0)
  goalsFor   Int      @default(0)
  goalsAgainst Int   @default(0)
  wins       Int      @default(0)
  draws      Int      @default(0)
  losses     Int      @default(0)

  @@unique([teamId, groupId])
}
